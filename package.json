{
  "name": "nostalgui",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-registry-docs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-registry-docs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "docs:generate": "node scripts/generate-registry-docs.mjs",
    "pretypecheck": "node scripts/generate-registry-docs.mjs",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "registry:build": "node scripts/generate-registry-docs.mjs && node scripts/build-theme-registry-item.mjs && shadcn build && node scripts/build-sound-meta.mjs",
    "check:style": "node scripts/check-style.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:style && npm run docs:generate",
    "stars:bake": "node scripts/bake-twinkle-star.mjs --write"
  },
  "dependencies": {
    "@nsmr/pixelart-react": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.18.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
